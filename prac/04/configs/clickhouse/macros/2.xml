<clickhouse>
    <!-- Макросы — строки-подстановки, доступные в SQL как {name} на ЭТОМ узле -->
    <macros>
        <!-- Имя кластера: такое же, как у соседней реплики ch1 -->
        <cluster>energosbyt</cluster>
        <!-- Номер шарда -->
        <!-- Шард тот же, что у ch1: реплики одной пары обязаны делить номер шарда -->
        <shard>1</shard>
        <!-- Номер реплики внутри шарда -->
        <!-- путь в Keeper: /clickhouse/tables/1/.../replicas/2 -->
        <replica>2</replica>
    </macros>
</clickhouse>
