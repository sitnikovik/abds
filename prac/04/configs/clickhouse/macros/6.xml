<clickhouse>
    <!-- Макросы — строки-подстановки, доступные в SQL как {name} на ЭТОМ узле -->
    <macros>
        <cluster>energosbyt</cluster>
        <!-- Номер шарда -->
        <!-- ch6 — вторая реплика третьего шарда -->
        <shard>3</shard>
        <!-- Номер реплики внутри шарда -->
        <!-- путь в Keeper: /clickhouse/tables/3/...replicas/2 -->
        <replica>2</replica>
    </macros>
</clickhouse>
